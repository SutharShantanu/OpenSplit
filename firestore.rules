rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users: only the owner can write; any authenticated user can read
    // (needed so group members can look up each other's display names)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Friend invites: the inviter manages them; the addressed recipient can read and answer.
    match /invites/{inviteId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.inviterUid
        || request.auth.token.email.lower() == resource.data.email
      );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.inviterUid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.inviterUid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && request.auth.token.email.lower() == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
    }

    // Invite links: any signed-in user can read one (to see the group name before joining);
    // only the creator can revoke; joiners may only bump `uses` by one.
    match /inviteLinks/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.uses == 0;
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
          && request.resource.data.uses == resource.data.uses + 1)
      );
      allow delete: if false;
    }

    // Friend links: "add me" codes. Anyone signed in can read one; only the owner creates it.
    match /friendLinks/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Groups: readable/writable only by members, plus a self-join path for valid invite links.
    match /groups/{groupId} {
      allow read, delete: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberIds
        || isValidSelfJoin(groupId)
      );
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds;

      function isValidSelfJoin(groupId) {
        let link = get(/databases/$(database)/documents/inviteLinks/$(request.resource.data.lastJoinToken)).data;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'lastJoinToken'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && !(request.auth.uid in resource.data.memberIds)
          && link.groupId == groupId
          && link.revoked == false
          && (link.expiresAt == null || link.expiresAt > request.time)
          && (link.maxUses == 0 || link.uses < link.maxUses);
      }

      // Expenses: inherit group membership check via get()
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }

      // Settlements
      match /settlements/{settlementId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }

      // Activity
      match /activity/{activityId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false; // Activity log is immutable
      }

      // Expense comments
      match /expenses/{expenseId}/comments/{commentId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }

      // Pending invites
      match /pendingInvites/{inviteId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }
    }
  }
}
