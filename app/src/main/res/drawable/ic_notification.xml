<?xml version="1.0" encoding="utf-8"?>
<!-- Status bar icon: the launcher's split-circle mark, cropped to its bounds. The system
     only uses the alpha channel, so the colour does not matter. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <group android:translateX="-30" android:translateY="-30">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M54,34 A20,20 0 1,1 53.99,34 Z M54,34 L54,74 M54,54 L74,54" />
    </group>
</vector>
