<?xml version="1.0" encoding="utf-8"?>
<!-- Encrypted AI keys are bound to this device's keystore; restoring them elsewhere
     only yields undecryptable ciphertext. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_keys.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_keys.xml"/>
    </device-transfer>
</data-extraction-rules>
